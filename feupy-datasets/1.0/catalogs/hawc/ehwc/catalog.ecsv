# %ECSV 1.0
# ---
# datatype:
# - {name: source_name, datatype: string, description: Source name}
# - {name: ra, unit: deg, datatype: float64, format: .3f, description: Right Ascension (J2000)}
# - {name: ra_err, unit: deg, datatype: float64, format: .3f, description: Statistical uncertainty on right ascension}
# - {name: dec, unit: deg, datatype: float64, format: .3f, description: Declination (J2000)}
# - {name: dec_err, unit: deg, datatype: float64, format: .3f, description: Statistical uncertainty on declination}
# - {name: spec_type, datatype: string, description: Spectral model type}
# - {name: extension_56TeV, unit: deg, datatype: float64, format: .3f, description: Source extension above 56 TeV; NaN means point-like
#     source}
# - {name: extension_56TeV_err, unit: deg, datatype: float64, format: .3f, description: Statistical uncertainty on extension_56TeV}
# - {name: flux_56TeV, unit: ph / (s cm2), datatype: float64, format: .3e, description: Integral flux above 56 TeV}
# - {name: flux_56TeV_err, unit: ph / (s cm2), datatype: float64, format: .3e, description: Statistical uncertainty on flux_56TeV}
# - {name: sqrt_TS_56TeV, datatype: float64, format: .2f, description: Square root of TS above 56 TeV}
# - {name: sqrt_TS_100TeV, datatype: float64, format: .2f, description: Square root of TS above 100 TeV}
# - {name: nearest_2hwc_source, datatype: string, description: Nearest 2HWC source}
# - {name: distance_to_2hwc, unit: deg, datatype: float64, format: .3f, description: Angular distance to nearest 2HWC source}
# - {name: sed_e_ref, unit: TeV, datatype: string, format: .3f, description: Reference energy, subtype: 'float64[10]'}
# - {name: sed_e2dnde, unit: TeV / (s cm2), datatype: string, format: .3e, description: SED value, subtype: 'float64[10]'}
# - {name: sed_e2dnde_errp, unit: TeV / (s cm2), datatype: string, format: .3e, description: SED positive error, subtype: 'float64[10]'}
# - {name: sed_e2dnde_errn, unit: TeV / (s cm2), datatype: string, format: .3e, description: SED negative error, subtype: 'float64[10]'}
# - {name: sed_e2dnde_ul, unit: TeV / (s cm2), datatype: string, format: .3e, description: SED upper limit, subtype: 'float64[10]'}
# - {name: sed_is_ul, datatype: string, description: SED upper limit flag, subtype: 'bool[10]'}
